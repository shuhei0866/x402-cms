{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R0 Run Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "experiment", "status", "edition", "arm",
    "model", "effort", "prompt_version", "prompt_digest",
    "system_instructions_digest", "profile_version", "profile_digest",
    "source_snapshot_digest", "randomization_seed", "started_at",
    "completed_at", "tool_policy", "metrics"
  ],
  "properties": {
    "schema_version": {"const": "r0-run-manifest-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "experiment": {"const": "A"},
    "status": {"enum": ["completed", "failed", "timeout"]},
    "edition": {"type": "string"},
    "arm": {"enum": ["H", "J"]},
    "model": {"type": "string", "minLength": 1},
    "effort": {"type": "string", "minLength": 1},
    "prompt_version": {"type": "string", "minLength": 1},
    "prompt_digest": {"type": "string"},
    "system_instructions_digest": {"type": "string"},
    "profile_version": {"type": "string", "minLength": 1},
    "profile_digest": {"type": "string"},
    "source_snapshot_digest": {"type": "string"},
    "representation_digest": {"type": ["string", "null"]},
    "runner_input_digest": {"type": ["string", "null"]},
    "codex_cli_version": {"type": ["string", "null"]},
    "randomization_seed": {"type": "integer"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "tool_policy": {"type": "string", "minLength": 1},
    "failure_reason": {"type": ["string", "null"]},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_bytes", "wall_clock_ms", "model_calls", "tool_calls",
        "response_schema_valid", "exactly_three_items_valid",
        "evidence_urls_present", "duplicate_recommendation_count"
      ],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reasoning_output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "input_bytes": {"type": "integer", "minimum": 0},
        "representation_bytes": {"type": ["integer", "null"], "minimum": 0},
        "wall_clock_ms": {"type": "integer", "minimum": 0},
        "model_calls": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "response_schema_valid": {"type": "boolean"},
        "exactly_three_items_valid": {"type": "boolean"},
        "evidence_urls_present": {"type": "boolean"},
        "duplicate_recommendation_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
