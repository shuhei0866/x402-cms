{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://x402-cms.example/benchmarks/agent-friendliness/result-v1.json",
  "title": "R0 Benchmark Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["weekly_thesis", "top_items", "uncertainties"],
  "properties": {
    "weekly_thesis": {"type": "string", "minLength": 1},
    "top_items": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason", "evidence_urls", "recommended_action"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "evidence_urls": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^https?://"}
          },
          "recommended_action": {"type": "string", "minLength": 1}
        }
      }
    },
    "uncertainties": {"type": "array", "items": {"type": "string"}}
  }
}
