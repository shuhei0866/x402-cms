# Your EVM address that will RECEIVE USDC payments.
# This file does NOT request a private key — only your public address.
# For Phase 0, use a Base Sepolia testnet address.
EVM_ADDRESS=0xYourBaseSepoliaAddressHere

# Facilitator that verifies and settles payments.
# x402.org/facilitator is the public default for testnet experimentation.
FACILITATOR_URL=https://x402.org/facilitator

# Anthropic API key for the Layer 2 LLM semantic pre-commit guard.
# Optional: if unset, the Layer 2 hook is a no-op.
# Get one at https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# GCP project that owns the Firestore database used by the indexers
# and the renderer. If unset, Application Default Credentials' configured
# project is used.
GOOGLE_CLOUD_PROJECT=my-utilities-490202

# Buyer mnemonic used only by scripts/dogfood_payment_loop.py to sign
# EIP-3009 USDC authorizations on Base Sepolia. The deployed server
# never reads this; it lives in the same .env for local convenience.
# Export from your wallet manager, for example:
#   node ~/Documents/agent-cli-legacy/dist/index.js wallet export --name explorer-agent
# .env is gitignored — leave empty in .env.example.
BUYER_MNEMONIC=

# X (Twitter) API bearer token for the Phase 2 x_indexer. Read-only
# app-only auth is enough for the public-tweet endpoints used here
# (GET /2/users/by/username/:handle and GET /2/users/:id/tweets).
# Get one from the X developer portal (Free tier suffices for a
# weekly run over a small handle list).
X_BEARER_TOKEN=
